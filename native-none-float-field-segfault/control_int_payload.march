-- CONTROL: repro.march with an Int payload (niche-safe). Works.
mod Repro do
  needs IO.Console

  fn start() : Option(Int) do
    let x = None
    x
  end

  fn main(_c : Cap(IO.Console)) : () do
    match start() do
    | None -> println("none")
    | Some(_) -> println("some")
    end
  end
end
