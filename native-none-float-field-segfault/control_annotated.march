-- CONTROL: repro.march with the let annotated. Works.
mod Repro do
  needs IO.Console

  fn start() : Option(Float) do
    let x : Option(Float) = None
    x
  end

  fn main(_c : Cap(IO.Console)) : () do
    match start() do
    | None -> println("none")
    | Some(_) -> println("some")
    end
  end
end
