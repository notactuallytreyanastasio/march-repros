-- Control: same program under a narrow grant, --target js. Rejected.
mod Main do
  needs IO.Console

  mod Pure do
    fn f() : Int do
      match Js.Dom.find("x") do
        Some(el) ->
          Js.Dom.set_text(el, "changed")
          match Js.Canvas.get_context(el) do
            Some(ctx) ->
              Js.Canvas.save(ctx)
              2
            None -> 1
          end
        None -> 0
      end
    end
  end

  fn main(_c : Cap(IO.Console)) : () do
    println(int_to_string(Pure.f()))
  end
end
