-- The same reads under a `needs ()` function bound. Also accepted.
mod Main do
  needs IO.Console

  mod Pure do
    cap pure
    fn direct() : Int needs () do
      sys_uptime_ms()
    end
    fn wrapped() : Int needs () do
      System.monotonic_time()
    end
  end

  fn spin(n : Int, acc : Int) : Int do
    if n == 0 do acc else spin(n - 1, acc + n % 7) end
  end

  fn main(_c : Cap(IO.Console)) : () do
    let a = Pure.direct()
    let b = Pure.wrapped()
    let w = spin(300000000, 0)
    let c = Pure.direct()
    let d = Pure.wrapped()
    println(int_to_string(a) ++ " " ++ int_to_string(b))
    println(int_to_string(c) ++ " " ++ int_to_string(d))
    println(int_to_string(w))
  end
end
