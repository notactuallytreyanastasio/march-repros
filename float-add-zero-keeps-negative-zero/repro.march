mod Repro do
  needs IO.Console

  fn add_zero(x : Float) : Float do
    0.0 +. x
  end

  fn add_zero_right(x : Float) : Float do
    x +. 0.0
  end

  fn sign(x : Float) : String do
    if Math.atan2(x, -1.0) < 0.0 do "-0" else "+0" end
  end

  fn main(_c : Cap(IO.Console)) : () do
    let n = string_to_float("-0.0")
    let m = match n do
      Some(v) -> v
      None -> 1.0
    end
    println("m: " ++ sign(m) ++ " (want -0)")
    println("0.0 +. m: " ++ sign(add_zero(m)) ++ " (IEEE: +0)")
    println("m +. 0.0: " ++ sign(add_zero_right(m)) ++ " (IEEE: +0)")
  end
end
