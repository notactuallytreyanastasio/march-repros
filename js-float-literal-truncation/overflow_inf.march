-- opt.fold produces +infinity; the JS emitter prints it as inf.0.
-- The literal is 1 followed by 308 zeros (the lexer has no exponent form), so x
-- overflows to infinity without any division by zero.
mod OverflowInf do
  needs IO.Console

  fn main(_c : Cap(IO.Console)) : () do
    let x = .0 *. 10.0
    println(float_to_string(x))
  end
end
